cc_defaults {
    name: "liblz4_defaults",
    vendor_available: true,
    vndk: {
        enabled: true,
    },
    host_supported: true,
    target: {
        windows: {
            enabled: true,
            shared: {
                enabled: false,
            },
        },
    },
    srcs: [
        "lz4.c",
        "lz4hc.c",
        "lz4frame.c",
        "xxhash.c",
    ],
    cflags: ["-Wall", "-Werror"],
    export_include_dirs: ["."],
}

cc_library {
    name: "liblz4",
    defaults: ["liblz4_defaults"],
}

cc_library {
    name: "liblz4_ndk",
    defaults: ["liblz4_defaults"],
    sdk_version: "current",
    stl: "none",
}
