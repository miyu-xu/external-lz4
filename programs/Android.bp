cc_binary {
    name: "lz4",
    host_supported: true,
    srcs: [
        "datagen.c",
        "bench.c",
        "lz4io.c",
        "lz4cli.c",
    ],
    cflags: ["-Wall", "-Werror"],
    static_libs: ["liblz4"],
    target: {
        host: {
            stl: "libc++_static",
        },
    },
}

cc_binary_host {
    name: "lz4c",
    cflags: [
        "-DENABLE_LZ4C_LEGACY_OPTIONS",
        "-Wall",
        "-Werror",
    ],
    srcs: [
        "datagen.c",
        "bench.c",
        "lz4io.c",
        "lz4cli.c",
    ],
    static_libs: ["liblz4"],
    stl: "libc++_static",
}
